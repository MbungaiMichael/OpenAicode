# Local dev (SQLite). Copy to .env — NEVER commit real keys (see .gitignore).
# Production Supabase example:
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="dev-secret-change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Supabase Storage (leave empty for local dev fallback; set in production .env only)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
STORAGE_BUCKET="medical-docs"
# TWA / APK signing (local .env only — NEVER commit real fingerprints)
TWA_PACKAGE_NAME="app.patientassist.twa"
TWA_SHA256_FINGERPRINTS=""
