# Production env template — PLACEHOLDERS ONLY. Copy to web/.env and fill in privately.
# NEVER commit filled-in values to GitHub.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
NEXTAUTH_SECRET="generate-32-char-random-string"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="PASTE-SERVICE-ROLE-KEY-PRIVATELY-NEVER-COMMIT"
STORAGE_BUCKET="medical-docs"

# Switch Prisma provider for production:
# 1. In web/prisma/schema.prisma change datasource provider to "postgresql"
# 2. npx prisma migrate dev --name init (Supabase) or prisma db push
# 3. npm run db:seed (demo users; change passwords immediately)
# Storage: use Supabase Storage bucket "medical-docs" (private) and paste signed URLs into Documents.
# Email: plug Resend/Nodemailer in lib/notify.ts to send on request_assigned/done + estimate_reply.
